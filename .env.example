# Human Infrastructure Layer - Environment Variables

# Get your API key from https://dashboard.hil.dev
HIL_API_KEY=hil_test_...

# Network: 'testnet' (default) or 'mainnet'
HIL_NETWORK=testnet

# Optional: USDC wallet for auto-settlement
HIL_WALLET_ADDRESS=0x...

# Optional: Webhook URL for async task notifications
HIL_WEBHOOK_URL=https://your-app.com/webhooks/hil

# Optional: Custom API base URL (for self-hosted)
# HIL_API_BASE=https://api.hil.dev/v1
